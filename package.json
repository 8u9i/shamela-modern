{
  "name": "shamela-modern",
  "version": "1.4.1",
  "description": "المكتبة الشاملة الإباضية — تطبيق سطح مكتب حديث للمكتبة الشاملة",
  "author": {
    "name": "المكتبة الشاملة الإباضية",
    "email": "dev@eshamila.net"
  },
  "main": "electron/main.js",
  "scripts": {
    "dev": "concurrently \"vite\" \"wait-on http://localhost:5173 && cross-env NODE_ENV=development electron .\"",
    "build": "vite build",
    "convert": "node scripts/convert.js",
    "pdf-catalog": "node scripts/export-pdf-catalog.js",
    "test": "node --test \"electron/*.test.js\"",
    "check:size": "node scripts/check-size.js",
    "package:win": "npm run build && electron-builder --win",
    "package:mac": "npm run build && electron-builder --mac",
    "package:linux": "npm run build && electron-builder --linux",
    "e2e": "npm run build && npx playwright test --config=e2e/playwright.config.ts",
    "e2e:dev": "npx playwright test --config=e2e/playwright.config.ts",
    "e2e:ui": "npx playwright test --ui --config=e2e/playwright.config.ts",
    "package:all": "npm run build && electron-builder -mwl"
  },
  "dependencies": {
    "@base-ui/react": "^1.6.0",
    "better-sqlite3": "^13.0.2",
    "electron-updater": "^6.8.9",
    "iconv-lite": "^0.6.3",
    "lucide-react": "^1.28.0",
    "mdb-reader": "^3.2.0",
    "node-stream-zip": "^1.15.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.0",
    "@tailwindcss/vite": "^4.3.3",
    "@types/better-sqlite3": "^7.6.11",
    "@types/node": "^22.0.0",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.5",
    "concurrently": "^10.0.4",
    "cross-env": "^7.0.3",
    "electron": "^43.2.0",
    "electron-builder": "^26.15.3",
    "playwright": "^1.62.0",
    "png2icons": "^2.0.1",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "vite": "^8.2.0",
    "wait-on": "^8.0.5"
  },
  "build": {
    "appId": "net.eshamila.modern",
    "productName": "Al-Maktaba Al-Shamela",
    "publish": {
      "provider": "github",
      "owner": "8u9i",
      "repo": "shamela-modern",
      "releaseType": "release"
    },
    "releaseInfo": {
      "releaseName": "المكتبة الشاملة الإباضية v${version}",
      "releaseNotes": "راجع [CHANGELOG.md](https://github.com/8u9i/shamela-modern/blob/master/CHANGELOG.md) للتفاصيل الكاملة عن التحديث."
    },
    "directories": {
      "output": "dist-app"
    },
    "files": [
      "electron/**/*",
      "dist/**/*"
    ],
    "asarUnpack": [
      "node_modules/better-sqlite3/**"
    ],
    "extraResources": [
      {
        "from": "resources/pdf-catalog.json",
        "to": "pdf-catalog.json"
      }
    ],
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "installerIcon": "assets/icon.ico",
      "uninstallerIcon": "assets/icon.ico",
      "installerHeaderIcon": "assets/icon.ico",
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "المكتبة الشاملة",
      "unicode": true,
      "deleteAppDataOnUninstall": false,
      "artifactName": "${productName}-Setup-${version}-${arch}.${ext}"
    },
    "mac": {
      "category": "public.app-category.reference",
      "target": [
        "dmg"
      ],
      "icon": "assets/icon.icns",
      "darkModeSupport": true,
      "artifactName": "${productName}-${version}-${arch}.${ext}"
    },
    "linux": {
      "target": [
        "deb",
        "AppImage"
      ],
      "icon": "assets",
      "category": "Education",
      "maintainer": "المكتبة الشاملة الإباضية <dev@eshamila.net>",
      "synopsis": "المكتبة الشاملة الإباضية",
      "description": "تطبيق سطح مكتب حديث للمكتبة الشاملة الإباضية — يضم أكثر من 2700 كتاب مع بحث نصي كامل",
      "artifactName": "${productName}-${version}.${ext}",
      "executableArgs": [
        "--no-sandbox",
        "--disable-gpu"
      ]
    },
    "win": {
      "target": [
        "nsis"
      ],
      "icon": "assets/icon.ico",
      "artifactName": "${productName}-Setup-${version}.${ext}"
    }
  }
}
